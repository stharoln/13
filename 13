%% 문제 1
clear; clc;
rng(13);
p = 0.35 + (0.95 - 0.35) * rand(1, 40);
results = rand(5000, 40) < p;
scores = sum(results, 2);
avg_score = mean(scores);
std_score = std(scores);
fprintf('평균점수: %.4f\n', avg_score);
fprintf('표준편차: %.4f\n', std_score);
above_avg = sum(scores >= avg_score) / 5000;
fprintf('평균 이상 학생 비율: %.4f\n', above_avg);
figure;
histogram(scores);
title('점수 분포');
xlabel('점수'); ylabel('학생 수');

%% 문제 2
clear; clc;
weights = 100 + 4 * randn(10000, 20);
box_avg = mean(weights, 2);
fail = box_avg < 98 | box_avg > 102;
fail_rate = sum(fail) / 10000;
fprintf('불합격률: %.4f\n', fail_rate);
figure;
histogram(box_avg);
xline(98, 'r', '98');
xline(102, 'r', '102');
title('상자 평균 무게 분포');
xlabel('평균 무게(g)'); ylabel('상자 수');

