%% 문제 4
clear; clc;
orders = poissrnd(180, 365, 1);
total_time = zeros(365, 1);
for d = 1:365
    t = 6 + 2 * randn(orders(d), 1);
    t(t < 0) = 0;
    total_time(d) = sum(t);
end
exceed_rate = sum(total_time > 1200) / 365;
fprintf('1200분 초과 날 비율: %.4f\n', exceed_rate);
figure;
subplot(2,1,1);
bar(orders);
title('하루 주문 수');
xlabel('날짜'); ylabel('주문 수');
subplot(2,1,2);
bar(total_time);
title('하루 총 처리 시간');
xlabel('날짜'); ylabel('시간(분)');
figure;
scatter(orders, total_time);
title('주문 수 vs 총 처리 시간');
xlabel('주문 수'); ylabel('처리 시간(분)');

%% 문제 5
clear; clc;
measurements = 25 + 0.8 * randn(10000, 30);
avg_meas = mean(measurements, 2);
in_range = avg_meas >= 24.7 & avg_meas <= 25.3;
prob = sum(in_range) / 10000;
fprintf('확률 추정값: %.4f\n', prob);
figure;
histogram(measurements(:,1), 'Normalization', 'probability');
hold on;
histogram(avg_meas, 'Normalization', 'probability');
legend('센서 1개', '센서 30개 평균');
title('측정값 분포 비교');
xlabel('온도(도)'); ylabel('확률');

%% 문제 6
clear; clc;
returns = 0.0008 + 0.015 * randn(5000, 60);
asset = 100 * cumprod(1 + returns, 2);
final = asset(:, end);
fprintf('최종 자산 평균: %.4f\n', mean(final));
fprintf('최솟값: %.4f\n', min(final));
fprintf('최댓값: %.4f\n', max(final));
loss_prob = sum(final < 100) / 5000;
fprintf('100 미만 확률: %.4f\n', loss_prob);
idx = randperm(5000, 30);
figure;
plot([zeros(30,1), asset(idx,:)]');
title('자산 경로 (30개)');
xlabel('일'); ylabel('자산가치');

%% 문제 7
clear; clc;
inter = exprnd(8, 300, 1);
arrive = cumsum(inter);
service = 10 + 3 * randn(300, 1);
service(service < 1) = 1;
start_t = zeros(300, 1);
end_t = zeros(300, 1);
start_t(1) = arrive(1);
end_t(1) = start_t(1) + service(1);
for i = 2:300
    start_t(i) = max(arrive(i), end_t(i-1));
    end_t(i) = start_t(i) + service(i);
end
wait = start_t - arrive;
fprintf('평균 대기시간: %.4f분\n', mean(wait));
fprintf('최대 대기시간: %.4f분\n', max(wait));
fprintf('20분 초과 비율: %.4f\n', sum(wait > 20) / 300);
figure;
histogram(wait);
title('대기시간 분포');
xlabel('대기시간(분)'); ylabel('환자 수');

