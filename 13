%% 문제 9
clear; clc;
n = 50000;
pass1 = rand(n, 1) < 0.94;
pass2 = false(n, 1);
pass2(pass1) = rand(sum(pass1), 1) < 0.91;
pass3 = false(n, 1);
pass3(pass2) = rand(sum(pass2), 1) < 0.88;
final_pass_rate = sum(pass3) / n;
fprintf('최종 합격률: %.4f\n', final_pass_rate);
fail1 = sum(~pass1);
fail2 = sum(pass1 & ~pass2);
fail3 = sum(pass2 & ~pass3);
final_pass = sum(pass3);
figure;
bar([fail1, fail2, fail3, final_pass]);
xticklabels({'1단계 탈락','2단계 탈락','3단계 탈락','최종 합격'});
title('단계별 탈락/합격 현황');
ylabel('제품 수');

%% 문제 10
clear; clc;
n = 10000;
server_load = 35 * randn(n, 1);
overload = rand(n, 1) < 0.12;
power = 500 + server_load + 120 * overload;
exceed_rate = sum(power > 650) / n;
fprintf('650 초과 비율: %.4f\n', exceed_rate);
fprintf('과부하 발생일 평균 전력: %.4f\n', mean(power(overload)));
fprintf('과부하 비발생일 평균 전력: %.4f\n', mean(power(~overload)));
figure;
histogram(power);
title('전력 사용량 분포');
xlabel('전력 사용량'); ylabel('일수');
